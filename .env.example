# Copy to .env and replace every placeholder. Never use these values in production.
EVOLVE_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=evolve
POSTGRES_USER=evolve
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://evolve:replace-with-a-local-database-password@postgres:5432/evolve
